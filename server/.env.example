# 仅供本机 docker-compose.dev.yml 开发使用。不要在生产环境复用这些值。
POSTGRES_DB=edge_platform
POSTGRES_USER=edge_platform
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=54329

# 至少使用 32 个随机字符。示例值不能用于生产。
APP_JWT__SECRET=replace-with-a-random-local-development-jwt-secret
API_PORT=8080
# Optional absolute storage root override; Compose mounts the default path.
# APP_FILE__STORAGE_ROOT=/var/lib/edge-platform/uploads

# MQTT is disabled by default. Use mqtts:// and separate credential variables;
# never put username/password in APP_MQTT__URL.
# APP_MQTT__ENABLED=false
# APP_MQTT__URL=mqtts://mqtt.example.internal:8883
# APP_MQTT__USERNAME=change-me
# APP_MQTT__PASSWORD=change-me
# APP_MQTT__CA_FILE=/etc/edge-platform/mqtt/ca.pem
# APP_MQTT__CLIENT_CERT_FILE=/etc/edge-platform/mqtt/client.crt
# APP_MQTT__CLIENT_KEY_FILE=/etc/edge-platform/mqtt/client.key
